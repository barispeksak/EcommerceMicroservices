{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgresql;Port=5432;Database=trendyolDb;Username=postgres;Password=123456"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.MongoDB" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System":   "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "MongoDB",
        "Args": {
          "databaseUrl": "mongodb://mongo:27017/logsdb",
          "collectionName": "logs",
          "cappedMaxSizeMb": 100
        }
      }
    ],
    "Properties": { "Application": "EcommerceMicroservices" }
  }
}

