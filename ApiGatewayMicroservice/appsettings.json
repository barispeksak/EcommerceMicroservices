
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  
  "AllowedHosts": "*",
  
  "Jwt": {
    "Key": "C#fTjWnZr4u7x!A%D*G-KaPdSgVkYp3s"
  },

  "MongoDb": {
    "ConnectionString": "mongodb://mongo:27017",
    "Database": "ECommerceLogs"
  },

 "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System":   "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "MongoDB",
        "Args": {
          "databaseUrl": "mongodb://mongodb:27017/ECommerceLogs",
          "collectionName": "logs",
          "cappedMaxSizeMb": "1024",
          "cappedMaxDocuments": "1000000"
        }
      }
    ]
  },

  "ReverseProxy": {
    "Routes": {

      "auth-public": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/api/auth/login" }
      },
      "auth-register": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/api/auth/register" }
      },
      "auth-refresh": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/api/auth/refresh-token" }
      },
      "auth-protected": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "AuthorizationPolicy": "JwtPolicy"
      },
      "product": {
        "ClusterId": "productCluster",
        "Match": { "Path": "/api/products/{**catch-all}" },
        "AuthorizationPolicy": "JwtPolicy"
      },
      "address": {
        "ClusterId": "addressCluster",
        "Match": { "Path": "/api/address/{**catch-all}" },
        "AuthorizationPolicy": "JwtPolicy"
      },
      "paymenttype": {
        "ClusterId": "paymenttypeCluster",
        "Match": { "Path": "/api/paymenttype/{**catch-all}" },
        "AuthorizationPolicy": "JwtPolicy"
      },
      "productcategory": {
        "ClusterId": "productcategoryCluster",
        "Match": { "Path": "/api/productcategory/{**catch-all}" },
        "AuthorizationPolicy": "JwtPolicy"
      },
      "productconfiguration": {
        "ClusterId": "productconfigurationCluster",
        "Match": { "Path": "/api/productconfiguration/{**catch-all}" },
        "AuthorizationPolicy": "JwtPolicy"
      },
      "productitem": {
        "ClusterId": "productitemCluster",
        "Match": { "Path": "/api/productitems/{**catch-all}" },
        "AuthorizationPolicy": "JwtPolicy"
      },
      "shippingtype": {
        "ClusterId": "shippingtypeCluster",
        "Match": { "Path": "/api/shippingtype/{**catch-all}" },
        "AuthorizationPolicy": "JwtPolicy"
      },
      "shoporder": {
        "ClusterId": "shoporderCluster",
        "Match": { "Path": "/api/shoporder/{**catch-all}" },
        "AuthorizationPolicy": "JwtPolicy"
      },
      "shoppingcart": {
        "ClusterId": "shoppingcartCluster",
        "Match": { "Path": "/api/shoppingcart/{**catch-all}" },
        "AuthorizationPolicy": "JwtPolicy"
      },
      "useraddress": {
        "ClusterId": "useraddressCluster",
        "Match": { "Path": "/api/useraddress/{**catch-all}" },
        "AuthorizationPolicy": "JwtPolicy"
      },
      "user": 
      {
        "ClusterId": "userCluster",
        "Match": { "Path": "/api/user/{**catch-all}" },
        "AuthorizationPolicy": "JwtPolicy"
      },
      "variation": {
        "ClusterId": "variationCluster",
        "Match": { "Path": "/api/variation/{**catch-all}" },
        "AuthorizationPolicy": "JwtPolicy"
      },
      "variationoption": {
        "ClusterId": "variationoptionCluster",
