      },
      "orderstatus": {
        "ClusterId": "orderstatusCluster",
        "Match": { "Path": "/api/orderstatus/{**catch-all}" },
        "AuthorizationPolicy": "JwtPolicy"
      }
    },
    "Clusters": {
